# ============================================================
# VDAM Evaluation & Deployment Environment Configuration
# ============================================================

# ------------------------------------------------------------
# 1. LOCALHOST DEVELOPMENT (Single-machine default)
# ------------------------------------------------------------
# When running all components on a single machine or laptop,
# leave these set to localhost / 127.0.0.1.
BANK_HOST=localhost
TPP_HOST=localhost
WALLET_HOST=localhost

# ------------------------------------------------------------
# 2. MULTI-VM BENCHMARK DEPLOYMENT
# ------------------------------------------------------------
# When deploying across multiple Virtual Machines:
# - On TPP VM: Set BANK_HOST to the IP address of the Bank VM.
# - On Bank VM: Set BANK_HOST to its own externally reachable IP
#   so Keycloak advertises the correct issuer and hostname URL.
#
# Examples:
# BANK_HOST=192.168.1.10
# TPP_HOST=192.168.1.20
# WALLET_HOST=192.168.1.30
