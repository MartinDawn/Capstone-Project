events {
    worker_connections 1024;
}

http {
    client_header_buffer_size 64k;
    large_client_header_buffers 4 64k;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    # ── 1. Browser UI Ingress (:4443) ────────────────────────────
    server {
        listen 4443 ssl;
        server_name localhost;

        ssl_certificate     /certs/browser.crt;
        ssl_certificate_key /certs/browser.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://tpp-java:6001;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Forwarded-Host $http_host;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        }
    }

    # ── 2. Classical API Ingress (:6443) ─────────────────────────
    # Standard TLS 1.3 for Machine-to-Machine VC Presentation
    server {
        listen 6443 ssl;
        server_name tls-tpp-ingress;

        ssl_certificate     /certs/tpp.crt;
        ssl_certificate_key /certs/tpp.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://tpp-java:6001;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Forwarded-Host $http_host;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        }
    }

    # ── 3. Outbound to Bank (:19443 -> Bank :8443 via ECDSA mTLS) ──
    server {
        listen 19443;
        server_name tls-tpp-bank;

        location / {
            proxy_pass https://${BANK_HOST}:8443;

            # mTLS Client Authentication to Bank Server Proxy
            proxy_ssl_name                tls-server-proxy;
            proxy_ssl_server_name         on;
            proxy_ssl_certificate         /certs/tpp.crt;
            proxy_ssl_certificate_key     /certs/tpp.key;
            proxy_ssl_trusted_certificate /certs/ca.crt;
            proxy_ssl_verify              on;
            proxy_ssl_protocols           TLSv1.3 TLSv1.2;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
