events {
    worker_connections 1024;
}

http {
    server {
        listen 19443;
        server_name tls-tpp-outbound-bank;

        location / {
            proxy_pass https://${BANK_HOST}:8443;
            
            # mTLS Client Authentication to Bank Server Proxy
            proxy_ssl_name                tls-server-proxy;
            proxy_ssl_server_name         on;
            proxy_ssl_certificate         /certs/tpp.crt;
            proxy_ssl_certificate_key     /certs/tpp.key;
            proxy_ssl_trusted_certificate /certs/ca.crt;
            proxy_ssl_verify              on;
            proxy_ssl_protocols           TLSv1.3 TLSv1.2;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }

    server {
        listen 15443;
        server_name tls-tpp-outbound-wallet;

        location / {
            proxy_pass https://${WALLET_HOST}:5443;
            
            # mTLS Client Authentication to Wallet Inbound Proxy
            proxy_ssl_name                tls-wallet-inbound;
            proxy_ssl_server_name         on;
            proxy_ssl_certificate         /certs/tpp.crt;
            proxy_ssl_certificate_key     /certs/tpp.key;
            proxy_ssl_trusted_certificate /certs/ca.crt;
            proxy_ssl_verify              on;
            proxy_ssl_protocols           TLSv1.3 TLSv1.2;

            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
