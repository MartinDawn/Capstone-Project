      "redirectUris": [
        "https://localhost:3443/callback",
        "https://localhost:5443/callback",
        "http://localhost:5000/callback"
      ],
      "webOrigins": [
        "https://localhost:3443",
        "http://localhost:5000"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "banking",
        "transfer",
        "offline_access",
        "identity_credential",
        "authorization_credential",
        "accounts:read",
        "transfers:read",
        "transfers:write",
        "profile:read",
        "cards:read",
        "loans:read",
        "ReadAccountsBasic",
        "ReadAccountsDetail",
        "ReadBalances",
        "ReadTransactionsBasic",
        "ReadTransactionsDetail",
        "ReadDirectDebits"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "require.pushed.authorization.requests": "true",
        "id.token.signed.response.alg": "ES256",
        "access.token.signed.response.alg": "ES256",
        "post.logout.redirect.uris": "https://localhost:3443/",
        "use.jwks.url": "true",
        "jwks.url": "http://wallet:5000/api/jwks",
        "x509.subjectdn": "(?i).*(wallet-client|Classical Wallet Client|Hybrid PQC Wallet Client).*",
        "x509.allow.regex.pattern.comparison": "true",
        "tls.client.certificate.bound.access.tokens": "true"
      }
    },
