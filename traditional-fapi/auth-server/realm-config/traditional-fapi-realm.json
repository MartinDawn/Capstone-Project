{
  "realm": "traditional-fapi",
  "displayName": "Traditional FAPI 2.0 Open Banking Realm",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "PS256",
  "revokeRefreshToken": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 300,
  "accessCodeLifespanUserAction": 300,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard bank customer role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ],
    "client": {
      "tpp-client": [
        {
          "name": "accounts:read",
          "description": "Read account balances and details"
        },
        {
          "name": "transfers:read",
          "description": "Read transaction history"
        },
        {
          "name": "transfers:write",
          "description": "Initiate transfers"
        }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "openid",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "OpenID Identity Information"
      }
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "User profile data (Name, username)"
      }
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Email address"
      }
    },
    {
      "name": "accounts:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your bank accounts and balances"
      }
    },
    {
      "name": "transfers:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your transaction history"
      }
    },
    {
      "name": "transfers:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Initiate fund transfers"
      }
    },
    {
      "name": "ReadAccountsDetail",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read account details and balances (Open Banking UK)"
      }
    },
    {
      "name": "ReadAccountsBasic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read basic account details (Open Banking UK)"
      }
    },
    {
      "name": "ReadBalances",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read account balances (Open Banking UK)"
      }
    },
    {
      "name": "ReadTransactionsDetail",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read transaction history (Open Banking UK)"
      }
    },
    {
      "name": "ReadTransactionsBasic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read basic transactions (Open Banking UK)"
      }
    },
    {
      "name": "CreateDomesticPayment",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Create domestic payment (Open Banking UK)"
      }
    },
    {
      "name": "ReadDirectDebits",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read direct debits (Open Banking UK)"
      }
    },
    {
      "name": "rs-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "rs-client-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "resource-server-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "rs-url-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://localhost:4000",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "external-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "external-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "aud:external-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "holder-approved-acc-001",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access holder-approved account ACC-001"
      }
    },
    {
      "name": "holder-approved-acc-002",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Access holder-approved account ACC-002"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email"
  ],
  "defaultOptionalClientScopes": [
    "accounts:read",
    "transfers:read",
    "transfers:write",
    "offline_access",
    "ReadAccountsDetail",
    "ReadAccountsBasic",
    "ReadBalances",
    "ReadTransactionsDetail",
    "ReadTransactionsBasic",
    "ReadDirectDebits",
    "CreateDomesticPayment"
  ],
  "clients": [
    {
      "clientId": "tpp-client",
      "name": "TPP Application",
      "description": "Third-Party Provider application for FAPI 2.0 Open Banking",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "tpp-client-secret-key-12345",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "consentRequired": true,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost:3000/callback",
        "https://localhost:3000/*",
        "https://127.0.0.1:3000/callback",
        "https://127.0.0.1:3000/*",
        "https://tpp-fapi:3000/callback",
        "https://tpp-fapi:3000/*",
        "https://203.0.113.20:3000/callback",
        "https://203.0.113.20:3000/*",
        "http://localhost:3000/callback",
        "http://localhost:3000/*",
        "http://tpp-fapi:3000/callback",
        "http://tpp-fapi:3000/*",
        "http://203.0.113.20:3000/callback",
        "http://203.0.113.20:3000/*",
        "*"
      ],
      "webOrigins": [
        "https://localhost:3000",
        "https://127.0.0.1:3000",
        "https://tpp-fapi:3000",
        "https://203.0.113.20:3000",
        "http://localhost:3000",
        "+"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "accounts:read",
        "transfers:read",
        "transfers:write",
        "offline_access",
        "ReadAccountsDetail",
        "ReadAccountsBasic",
        "ReadBalances",
        "ReadTransactionsDetail",
        "ReadTransactionsBasic",
        "ReadDirectDebits",
        "CreateDomesticPayment",
        "rs-audience",
        "external-audience",
        "holder-approved-acc-001",
        "holder-approved-acc-002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "require.pushed.authorization.requests": "false",
        "tls.client.certificate.bound.access.tokens": "true",
        "id.token.signed.response.alg": "PS256",
        "access.token.signed.response.alg": "PS256",
        "post.logout.redirect.uris": "https://localhost:3000/"
      },
      "protocolMappers": []
    },
    {
      "clientId": "short-lived-client",
      "name": "Conformance Short-Lived Token Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "short-lived-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://localhost:3000/*",
        "https://127.0.0.1:3000/*",
        "*"
      ],
      "webOrigins": [
        "https://localhost:3000",
        "+"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "accounts:read",
        "ReadAccountsDetail",
        "holder-approved-acc-001",
        "holder-approved-acc-002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "tls.client.certificate.bound.access.tokens": "true",
        "access.token.signed.response.alg": "PS256",
        "access.token.lifespan": "1"
      },
      "protocolMappers": []
    },
    {
      "clientId": "resource-server-client",
      "name": "Banking Resource Server Client",
      "description": "Resource Server audience client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rs-client-secret-key-12345",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.signed.response.alg": "PS256"
      }
    }
  ],
