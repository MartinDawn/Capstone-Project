  "operation_mapping": {
    "list_accounts": {
      "method": "GET",
      "path": "/open-banking/v3.1/aisp/accounts",
      "required_permission": "ReadAccountsDetail"
    },
    "get_account": {
      "method": "GET",
      "path_template": "/open-banking/v3.1/aisp/accounts/{account_id}",
      "required_permission": "ReadAccountsDetail"
    },
    "get_balances": {
      "method": "GET",
      "path_template": "/open-banking/v3.1/aisp/accounts/{account_id}/balances",
      "required_permission": "ReadBalances"
    },
    "get_transactions": {
      "method": "GET",
      "path_template": "/open-banking/v3.1/aisp/accounts/{account_id}/transactions",
      "required_permissions": ["ReadTransactionsDetail", "ReadTransactionsCredits"],
      "query_parameters": ["fromBookingDateTime", "toBookingDateTime", "page", "page-size"]
    },
    "get_account_direct_debits": {
      "method": "GET",
      "specified_path_template": "/accounts/{account_id}/direct-debits",
      "required_permission": "ReadDirectDebits",
      "implementation_status": "missing_in_all_three_current_resource_servers",
      "core_workload_included": false
    },
    "list_direct_debits": {
      "method": "GET",
      "specified_path": "/direct-debits",
      "required_permission": "ReadDirectDebits",
      "implementation_status": "missing_in_all_three_current_resource_servers",
      "core_workload_included": false
    }
  },
